{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nade Viewer",
  "version": "0.1.0",
  "identifier": "app.nadeviewer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nade Viewer",
        "width": 1280,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "resources": "resources"
    },
    "icon": ["icons/icon.ico"]
  }
}
